[Unit]
Description=Dudu Private Duo Chat WebSocket Relay Server
Documentation=https://github.com/
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tryss-archos
WorkingDirectory=/home/tryss-archos/AI Workspace/Dudu-Project_(For Nana)/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dudu-chat-relay

# Environment configuration
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0

# Hardening & Security Sandbox
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/tryss-archos/AI Workspace/Dudu-Project_(For Nana)/server

[Install]
WantedBy=multi-user.target
