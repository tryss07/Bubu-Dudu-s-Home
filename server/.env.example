# Dudu Private Duo Relay Server Configuration (Template)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Layer 1 Security: Application-level Auth Secret
# Generate a random hex token (e.g. openssl rand -hex 32)
RELAY_AUTH_TOKEN=your_secure_random_hex_token_here

# Cloudflare Tunnel / Reverse Proxy Origin Secret Guard (Optional)
# If set, all incoming HTTP and WebSocket requests must include header: X-Tunnel-Secret
TUNNEL_SECRET=
